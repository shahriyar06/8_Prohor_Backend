// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
  // output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum AccountType {
  personal
  organization
}

enum UserRole {
  user
  super_admin
}


model User {
  id                 String      @id @default(uuid())
  name               String
  email              String      @unique
  passwordHash       String?     @map("password_hash")
  accountType        AccountType @map("account_type")
  languagePref       String      @default("en") @map("language_pref")
  hasSeenOnboarding  Boolean     @default(false) @map("has_seen_onboarding")
  role               UserRole    @default(user)
  isEmailVerified    Boolean     @default(false) @map("is_email_verified")
  profilePhoto       String?     @map("profile_photo")
  priorityColors     Json?       @map("priority_colors")

  refreshTokens       RefreshToken[]
  verificationTokens  EmailVerificationToken[]

  ownedOrganizations   Organization[]
  organizationMembers  OrganizationMember[]

  comments      TaskComment[]
  commentLikes  TaskCommentLike[]
  tasks Task[]

  incomeCategories IncomeCategory[]
  incomes          Income[]

  expenseCategories ExpenseCategory[]
  expenses          Expense[]

  liabilities Liability[]

  receivables Receivable[]

  subscriptionPlan String    @default("personal_basic") @map("subscription_plan")
  trialEndsAt      DateTime? @map("trial_ends_at")

  createdAt          DateTime    @default(now()) @map("created_at")
  updatedAt          DateTime    @updatedAt @map("updated_at")

  @@map("users")
}

model RefreshToken {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String   @map("token_hash")
  expiresAt  DateTime @map("expires_at")
  revoked    Boolean  @default(false)
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("refresh_tokens")
}

model EmailVerificationToken {
  id          String    @id @default(uuid())
  userId      String    @map("user_id")
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  otpHash     String    @map("otp_hash")
  expiresAt   DateTime  @map("expires_at")
  attempts    Int       @default(0)
  usedAt      DateTime? @map("used_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@map("email_verification_tokens")
}

model Organization {
  id            String   @id @default(uuid())
  name          String
  ownerId       String   @map("owner_id")
  owner         User     @relation(fields: [ownerId], references: [id])

  prefix        String?  
  address       String?
  phoneNumber   String?  @map("phone_number")
  memberCounter Int      @default(0) @map("member_counter") 
  priorityColors Json?   @map("priority_colors")

  roles         Role[]
  members       OrganizationMember[]

  tasks Task[]

  incomeCategories IncomeCategory[]
  incomes          Income[]

  expenseCategories ExpenseCategory[]
  expenses          Expense[]

  liabilities Liability[]

  receivables Receivable[]

  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("organizations")
}

model Role {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String

  isSystem       Boolean  @default(false) @map("is_system")

  permissions    RolePermission[]
  members        OrganizationMember[]

  createdAt      DateTime @default(now()) @map("created_at")

  @@unique([organizationId, name])
  @@map("roles")
}

model RolePermission {
  id             String @id @default(uuid())
  roleId         String @map("role_id")
  role           Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  permissionKey  String @map("permission_key")

  @@unique([roleId, permissionKey])
  @@map("role_permissions")
}

enum Gender {
  male
  female
  other
}

enum EmploymentType {
  full_time
  part_time
  volunteer
  intern
}

enum MemberStatus {
  active
  inactive
  suspended
}

model OrganizationMember {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String   @map("user_id")
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleId         String   @map("role_id")
  role           Role     @relation(fields: [roleId], references: [id])

  profile        MemberProfile?

  assignedTasks  TaskAssignee[]

  joinedAt       DateTime @default(now()) @map("joined_at")

  @@unique([organizationId, userId])
  @@map("organization_members")
}


model MemberProfile {
  id                   String   @id @default(uuid())
  organizationMemberId String   @unique @map("organization_member_id")
  organizationMember   OrganizationMember @relation(fields: [organizationMemberId], references: [id], onDelete: Cascade)

  memberId       String   @map("member_id") // যেমন: MEM-0001
  profilePhoto   String?  @map("profile_photo")
  phoneNumber    String   @map("phone_number")
  dateOfBirth    DateTime @map("date_of_birth")
  gender         Gender
  bloodGroup     String?  @map("blood_group")
  nationality    String
  address        String
  designation    String
  department     String?
  joinDate       DateTime @map("join_date")
  employmentType EmploymentType @map("employment_type")
  memberStatus   MemberStatus   @default(active) @map("member_status")

  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@map("member_profiles")
}


enum TaskPriority {
  low
  medium
  high
}

enum TaskStatus {
  pending
  in_progress
  done
}

model TaskAttachment {
  id        String   @id @default(uuid())
  taskId    String   @map("task_id")
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  fileUrl   String   @map("file_url")
  fileType  String   @map("file_type") 
  fileName  String   @map("file_name")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("task_attachments")
}

model TaskChecklistItem {
  id        String   @id @default(uuid())
  taskId    String   @map("task_id")
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  text      String
  isDone    Boolean  @default(false) @map("is_done")
  order     Int      @default(0) // checklist-এর ক্রম ঠিক রাখতে
  createdAt DateTime @default(now()) @map("created_at")

  @@map("task_checklist_items")
}

model TaskComment {
  id              String   @id @default(uuid())
  taskId          String   @map("task_id")
  task            Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  authorId        String?  @map("author_id")
  author          User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)
  authorName      String   @map("author_name") 

  parentCommentId String?  @map("parent_comment_id") 
  parent          TaskComment?  @relation("CommentReplies", fields: [parentCommentId], references: [id], onDelete: Cascade)
  replies         TaskComment[] @relation("CommentReplies")

  content         String
  likes           TaskCommentLike[]

  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("task_comments")
}

model TaskCommentLike {
  id        String   @id @default(uuid())
  commentId String   @map("comment_id")
  comment   TaskComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([commentId, userId]) 
  @@map("task_comment_likes")
}

model TaskAssignee {
  id       String @id @default(uuid())
  taskId   String @map("task_id")
  task     Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  memberId String @map("member_id")
  member   OrganizationMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  assignedAt DateTime @default(now()) @map("assigned_at")

  @@unique([taskId, memberId]) // একই member একই task-এ দুইবার assign হবে না
  @@map("task_assignees")
}

model Task {
  id             String    @id @default(uuid())
  userId         String?   @map("user_id")
  user           User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdByName  String    @map("created_by_name")

  organizationId String?   @map("organization_id")
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  title          String
  description    String?
  dueDate        DateTime  @map("due_date")
  dueTime        String?   @map("due_time")
  priority       TaskPriority @default(medium)
  status         TaskStatus   @default(pending)
  isRecurring    Boolean   @default(false) @map("is_recurring")
  recurrenceRule String?   @map("recurrence_rule")
  tag            String?

  assignees      TaskAssignee[]
  attachments    TaskAttachment[]
  checklistItems TaskChecklistItem[]
  comments       TaskComment[]

  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@map("tasks")
}

model IncomeCategory {
  id             String   @id @default(uuid())
  userId         String?  @map("user_id")
  user           User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId String?  @map("organization_id")
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name           String
  isDefault      Boolean  @default(false) @map("is_default") // "Other" category, delete করা যাবে না

  incomes        Income[]

  createdAt      DateTime @default(now()) @map("created_at")

  @@map("income_categories")
}

model Income {
  id              String   @id @default(uuid())
  userId          String?  @map("user_id")
  user            User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdByName   String   @map("created_by_name")

  organizationId  String?  @map("organization_id")
  organization    Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  categoryId      String   @map("category_id")
  category        IncomeCategory @relation(fields: [categoryId], references: [id])

  amount          Decimal  @db.Decimal(12, 2)
  currency        String   @default("BDT")
  source          String?
  note            String?
  isRecurring     Boolean  @default(false) @map("is_recurring")
  recurrenceRule  String?  @map("recurrence_rule")
  date            DateTime

  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("incomes")
}

model ExpenseCategory {
  id             String   @id @default(uuid())
  userId         String?  @map("user_id")
  user           User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId String?  @map("organization_id")
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name           String
  isDefault      Boolean  @default(false) @map("is_default")

  expenses       Expense[]

  createdAt      DateTime @default(now()) @map("created_at")

  @@map("expense_categories")
}

model Expense {
  id              String   @id @default(uuid())
  userId          String?  @map("user_id")
  user            User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdByName   String   @map("created_by_name")

  organizationId  String?  @map("organization_id")
  organization    Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  categoryId      String   @map("category_id")
  category        ExpenseCategory @relation(fields: [categoryId], references: [id])

  amount          Decimal  @db.Decimal(12, 2)
  currency        String   @default("BDT")
  paymentMethod   String?  @map("payment_method")
  note            String?
  isRecurring     Boolean  @default(false) @map("is_recurring")
  recurrenceRule  String?  @map("recurrence_rule")
  date            DateTime

  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("expenses")
}

enum LiabilityStatus {
  pending
  partial
  paid
}

model Liability {
  id              String   @id @default(uuid())
  userId          String?  @map("user_id")
  user            User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdByName   String   @map("created_by_name")

  organizationId  String?  @map("organization_id")
  organization    Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  personName      String   @map("person_name")
  amount          Decimal  @db.Decimal(12, 2)
  paidAmount      Decimal  @default(0) @db.Decimal(12, 2) @map("paid_amount")
  currency        String   @default("BDT")
  reason          String?
  dueDate         DateTime @map("due_date")
  status          LiabilityStatus @default(pending)
  remindBeforeDays Int?    @map("remind_before_days")

  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("liabilities")
}

enum ReceivableStatus {
  pending
  partial
  received
}

model Receivable {
  id              String   @id @default(uuid())
  userId          String?  @map("user_id")
  user            User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdByName   String   @map("created_by_name")

  organizationId  String?  @map("organization_id")
  organization    Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  personName      String   @map("person_name")
  amount          Decimal  @db.Decimal(12, 2)
  receivedAmount  Decimal  @default(0) @db.Decimal(12, 2) @map("received_amount")
  currency        String   @default("BDT")
  reason          String?
  dueDate         DateTime @map("due_date")
  status          ReceivableStatus @default(pending)
  remindBeforeDays Int?    @map("remind_before_days")

  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("receivables")
}